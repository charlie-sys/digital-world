HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
# Model settings are saved by each user in the web UI. No shared API key.
# Legacy OpenAI-compatible LAN endpoints; native Ollama does not need this.
ALLOW_LOCAL_MODEL_URLS=0
# Optional Ollama root. Reads OLLAMA_HOST otherwise, then defaults to port 11434.
# Admin can override the address and enable sharing in the UI.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# World starts paused. Set to 1 to advance one hour every 30 seconds.
AUTO_RUN=0
# Email verification and password recovery (administrator configuration).
# Must match the URL users can open. HTTPS required except for localhost.
APP_URL=http://127.0.0.1:3000
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
